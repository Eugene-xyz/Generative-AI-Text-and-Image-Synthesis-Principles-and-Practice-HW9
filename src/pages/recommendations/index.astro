---
import BaseLayout from '../../layouts/BaseLayout.astro';
import RecommendationCard from '../../components/RecommendationCard.astro';
import { getLibrary, withBase } from '../../lib/wiki';
import { recommendationCatalogue } from '../../lib/recommendations';
import '../../styles/editorial.css';
const library=await getLibrary();
const catalogue=recommendationCatalogue(library);
---
<BaseLayout title="歌曲推薦" description="先聽 Dear、T.B.H、Dreamer，再從青春入門、陪伴與勇氣、樂團故事與創作、更多音樂面貌探索 QWER。每首保留推薦理由、版本與來源。">
  <main id="main" class="wrap guide-page">
    <nav class="editorial-breadcrumb" aria-label="麵包屑"><a href={withBase()}>首頁</a><span>/</span><span aria-current="page">歌曲推薦</span></nav>
    <header class="guide-index-hero"><div><p class="eyebrow section-label">FIND YOUR FIRST QWER SONG</p><h1>從一首歌，<br />找到你的入口<span>。</span></h1><p>先聽三首，再沿著四條路線，<br />讀懂歌曲背後的故事。</p></div><aside class="guide-count"><span class="display">{catalogue.picks.length}<i> / </i>{catalogue.groups.length}</span><p>首選曲 / 條聆聽路線</p><a class="text-link" href="#routes">找到今天想聽的主題 ↓</a></aside></header>
    <section class="guide-featured" aria-labelledby="start-title"><div class="editorial-section-heading"><div><p class="eyebrow section-label">01 / START HERE</p><h2 id="start-title">先聽這三首</h2></div><p>Dear → T.B.H → Dreamer<br />選曲順序是閱讀安排。</p></div><div class="guide-grid">{catalogue.featured.map((pick,index)=><RecommendationCard pick={pick} featured number={index+1} />)}</div></section>
    <nav id="routes" class="guide-route-nav" aria-label="聆聽路線">{catalogue.groups.map((group,index)=><a href={`#${group.id}`}><span class="display">0{index+1}</span><span>{group.label}</span><small>{group.picks.length} 首</small><span aria-hidden="true">↓</span></a>)}</nav>
    {catalogue.groups.map((group,index)=><section class="guide-category" id={group.id}><div class="editorial-section-heading"><div><p class="eyebrow section-label">ROUTE / 0{index+1}</p><h2>{group.label}</h2></div><a class="text-link" href="#routes">選擇其他路線 ↑</a></div><div class="guide-grid">{group.picks.map(pick=><RecommendationCard pick={pick} />)}</div></section>)}
    <aside class="guide-scope"><h2>聽同一首歌，也要看清楚版本。</h2><p>置頂三首也在各自分類中，清單共 {catalogue.picks.length} 首，不重複計數。推薦是本網站的編輯觀點，每首的歌曲背景另附來源。</p><p>數位作品優先提供已核對的同版 Spotify 專輯入口，導聆附曲目位置；官方公開歌曲保留影片入口。各作品的語言、混音、重製與再收錄限制仍可在版本段落查閱。</p><a class="text-link" href={withBase('discography/tracks/')}>探索全部曲目與版本 ↗</a></aside>
  </main>
</BaseLayout>
