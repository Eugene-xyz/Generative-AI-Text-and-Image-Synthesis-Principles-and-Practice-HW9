---
import BaseLayout from '../layouts/BaseLayout.astro';
import EventRecords from './EventRecords.astro';
import { eventView, timelineCatalogue, timelineCategories } from '../lib/timeline';
import { getLibrary, entryUrl, heading, withBase, type WikiEntry } from '../lib/wiki';
import '../styles/timeline.css';
interface Props { entry: WikiEntry; }
const { entry } = Astro.props;
const library = await getLibrary();
const view = eventView(entry,library);
const catalogue = timelineCatalogue(library);
const index = catalogue.nodes.findIndex(node=>node.id===entry.id);
const previous = catalogue.nodes[index-1];
const next = catalogue.nodes[index+1];
const sources = entry.data.sources.map(id=>library.bySource.get(id)!);
const links = view.detailed ? [['facts','事件資料'],['story','事件內容'],['dates','日期辨識'],['selection','收錄理由'],['limits','範圍與待查'],['references','本頁來源']] : [['story','事件說明'],['references','本頁來源']];
---
<BaseLayout title={`${view.title}｜時間線`} description={`${view.dateLabel}，${timelineCategories[view.category].label}。閱讀 QWER 的事件內容、日期依據與來源。`}>
  <main id="main" class="journey-page wrap">
    <nav class="journey-breadcrumb" aria-label="麵包屑"><a href={withBase()}>首頁</a><span aria-hidden="true">/</span><a href={withBase('timeline/')}>時間線</a><span aria-hidden="true">/</span><span aria-current="page">{timelineCategories[view.category].label}</span></nav>
    <header class="event-hero"><div><span class="eyebrow section-label">QWER / ON THE RECORD</span><span class="journey-category" data-kind={view.category}><span aria-hidden="true">{timelineCategories[view.category].code}</span>{timelineCategories[view.category].label}</span><h1>{view.title}</h1><div class="prose event-intro" set:html={view.summary}></div><a class="text-link" href={withBase(`timeline/#${view.anchor}`)}>← 回到這個時間節點</a></div><aside class="event-date-panel" aria-label="本事件的時間依據"><span class="eyebrow">WHEN IT HAPPENED</span><time datetime={view.start || undefined}>{view.start || '日期待查'}</time>{view.end && <><span class="event-until">至</span><time datetime={view.end}>{view.end}</time></>}<p>{view.basis}</p>{view.precision!=='day' && <p class="journey-precision">日期精度：{view.precision==='month' ? '月份' : view.precision==='year' ? '年份' : '待查'}</p>}<span class="event-verified">資料核對 {entry.data.verified_at ?? '待查'}</span></aside></header>
    <div class="event-story"><aside class="event-toc"><span class="eyebrow section-label">IN THIS MOMENT</span><nav aria-label="事件章節">{links.map(([id,label])=><a href={`#${id}`}>{label}</a>)}</nav><a class="text-link" href={withBase('timeline/')}>全部時間線 ↗</a></aside><article class="event-chapters">
      {view.detailed && <section class="event-chapter" id="facts"><span class="eyebrow section-label">THE DETAILS</span><h2>事件資料</h2><dl class="event-facts">{view.facts.map(field=><div><dt>{field.label}</dt><dd class="prose" set:html={field.value}></dd></div>)}</dl></section>}
      <section class="event-chapter" id="story"><span class="eyebrow section-label">WHAT HAPPENED</span><h2>{view.detailed ? '事件內容' : '事件說明'}</h2>{view.detailed ? <EventRecords content={view.content} /> : <><div class="prose" set:html={view.body}></div>{view.work && <div class="event-work-link"><span class="eyebrow section-label">THE RELEASE</span><h3><a href={entryUrl(view.work)}>{heading(view.work)} ↗</a></h3><p>發行日期依對應作品資料；曲目、版本、載體與收聽入口請見作品頁。</p><a class="button" href={entryUrl(view.work)}>查看作品與完整曲目 ↗</a></div>}</>}</section>
      {view.detailed && <><section class="event-chapter" id="dates"><span class="eyebrow section-label">DATES, WITH CONTEXT</span><h2>日期辨識</h2><EventRecords content={view.dates} /></section><section class="event-chapter" id="selection"><span class="eyebrow section-label">EDITORIAL CHOICE</span><h2>為什麼收錄這筆紀錄</h2><div class="prose" set:html={view.reason}></div></section><section class="event-chapter event-limitations" id="limits"><span class="eyebrow section-label">SCOPE & OPEN QUESTIONS</span><h2>範圍與待查</h2><div class="prose" set:html={view.limits}></div></section></>}
      <section class="event-chapter" id="references"><span class="eyebrow section-label">SOURCES</span><h2>本頁來源</h2><ol class="event-sources">{sources.map(source=><li><a href={source.data.url}>{source.data.title} ↗</a><p>{source.data.publisher} · 查閱 {source.data.accessed_at}</p><a class="source-scope" href={withBase(`sources/#${source.id}`)}>閱讀查核範圍</a></li>)}</ol><h3 class="event-related-heading">相關筆記</h3>{view.relatedHtml ? <div class="prose event-related" set:html={view.relatedHtml}></div> : <ul class="event-related">{entry.data.related.map(library.requireEntry).map(item=><li><a href={entryUrl(item)}>{heading(item)} ↗</a></li>)}</ul>}</section>
    </article></div>
    <nav class="event-pagination" aria-label="依時間繼續閱讀">{previous ? <a href={previous.href}><span>← 上一個時間節點</span><strong>{previous.title}</strong><small>{previous.dateLabel} · {timelineCategories[previous.category].label}</small></a> : <a href={withBase('timeline/')}><span>← 回到完整時間線</span><strong>從出道開始讀起</strong></a>}{next ? <a href={next.href}><span>下一個時間節點 →</span><strong>{next.title}</strong><small>{next.dateLabel} · {timelineCategories[next.category].label}</small></a> : <a href={withBase('discography/')}><span>繼續閱讀 →</span><strong>走進音樂作品</strong></a>}</nav><p class="journey-order-note">依已知日期／期間起日排列；同日節點的列序不代表當日先後。</p>
  </main>
</BaseLayout>
