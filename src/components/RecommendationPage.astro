---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getLibrary, heading, entryUrl, withBase, type WikiEntry } from '../lib/wiki';
import { recommendationCatalogue, recommendationView } from '../lib/recommendations';
import '../styles/editorial.css';
interface Props {entry:WikiEntry;}
const {entry}=Astro.props;
const library=await getLibrary();
const view=recommendationView(entry,library);
const siblings=recommendationCatalogue(library).picks.filter(pick=>pick.category===view.category && pick.entry.id!==entry.id);
const sources=entry.data.sources.map(id=>library.bySource.get(id)!);
---
<BaseLayout title={`${view.name}｜歌曲推薦`} description={`${view.audience} ${view.version}。閱讀推薦理由、歌曲背景與官方收聽入口。`}>
  <main id="main" class="wrap guide-page">
    <nav class="editorial-breadcrumb" aria-label="麵包屑"><a href={withBase()}>首頁</a><span>/</span><a href={withBase('recommendations/')}>歌曲推薦</a><span>/</span><span aria-current="page">{view.name}</span></nav>
    <header class="guide-detail-hero"><div><p class="eyebrow section-label">LISTENING NOTES / {view.categoryLabel}</p><h1 class="display">{view.name}</h1>{view.original && <p class="guide-original" lang="ko">{view.original}</p>}<p class="guide-detail-audience">{view.audience}</p><a class="button primary" href={view.listenUrl}>▷ {view.listenLabel} ↗</a><p class="guide-locator">{view.locator}</p></div><aside class="guide-version-panel"><span class="eyebrow section-label">THE VERSION</span><h2>這次推薦的版本</h2><p>{view.version}</p><a class="text-link" href={view.versionHref}>對照作品中的版本與介紹 ↗</a><span class="guide-checked">背景資料核對 {entry.data.verified_at} · 未驗證完整音訊播放</span></aside></header>
    <div class="editorial-story"><aside class="editorial-toc"><span class="eyebrow section-label">IN THIS NOTE</span><nav aria-label="導聆章節"><a href="#guide">推薦理由</a><a href="#background">歌曲背景</a><a href="#version">版本與收聽</a><a href="#references">來源與延伸</a></nav></aside><article class="editorial-chapters">
      <section id="guide"><span class="eyebrow section-label">WHY THIS SONG</span><h2>為什麼推薦這首</h2><div class="prose guide-main-reason" set:html={view.reason}></div><p class="editorial-note">這是本網站的導聆安排；歌曲背景與版本依據見下方來源。</p></section>
      <section id="background"><span class="eyebrow section-label">BEHIND THE SONG</span><h2>歌曲背景</h2><div class="prose" set:html={view.background}></div></section>
      <section id="version"><span class="eyebrow section-label">LISTEN WITH CONTEXT</span><h2>版本與官方收聽</h2><dl class="editorial-facts">{view.versionFields.map(field=><div><dt>{field.label}</dt><dd class="prose" set:html={field.value}></dd></div>)}</dl><div class="prose" set:html={view.versionNotes}></div><div class="guide-listen-actions"><a class="button" href={view.listenUrl}>▷ {view.listenLabel} ↗</a><a class="text-link" href={entryUrl(view.work)}>閱讀 {heading(view.work)} ↗</a></div><p class="editorial-note">前往外部平台後，由你選擇播放；登入、訂閱與地區限制依平台提供。</p></section>
      <section id="references"><span class="eyebrow section-label">SOURCES & CONNECTIONS</span><h2>來源與延伸閱讀</h2><ol class="editorial-sources">{sources.map(source=><li><a href={source.data.url}>{source.data.title} ↗</a><p>{source.data.publisher} · 查閱 {source.data.accessed_at}</p><a href={withBase(`sources/#${source.id}`)}>查核範圍</a></li>)}</ol><div class="prose" set:html={view.related}></div></section>
    </article></div>
    <section class="guide-next"><div><span class="eyebrow section-label">KEEP LISTENING</span><h2>繼續探索「{view.categoryLabel}」</h2></div><ul>{siblings.sort((a,b)=>a.order-b.order).map(pick=><li><a href={pick.href}><span class="display">{pick.name}</span><span>{pick.audience}</span><span aria-hidden="true">↗</span></a></li>)}</ul><a class="text-link" href={withBase('recommendations/')}>回到全部歌曲推薦 ↗</a></section>
  </main>
</BaseLayout>
